# Copy to .env and fill in.

# User and group the containers run as (owner of this folder): `id -u`, `id -g`.
PUID=
PGID=
TZ=

# Optional: sign-ins are easiest set on the Dashboard (Sign-ins), which come first. Or files:
# X cookies exported from your browser (Netscape cookies.txt format), for your X timelines
# in the Feed.
# Keep it outside version control.
X_COOKIES_FILE=

# Chaturbate cookies (Netscape cookies.txt), so the Following page knows which rooms you
# follow. Replace the file in place (cp over it) when you export them again.
CHATURBATE_COOKIES_FILE=
# Your own videos of the rooms you follow (a folder per room, or files named after the room),
# shown on each room's profile in the Live tab (with highlights and delete). An empty folder if you have none.
CB_VIDEOS_DIR=
# A group that can write there, when your recorder makes the folders as another user (e.g. root,
# with the folder's ACL giving a group write): its number (getent group NAME). Empty: PGID.
CB_VIDEOS_GID=
# Your recorder, streamonitor, run from the Live tab (Record, Pause, Remove; what it's doing):
# its web address as the web service reaches it (a Docker network they share, e.g.
# http://streamonitor:5000), and its password if it has one. Empty: off.
STREAMONITOR_URL=
STREAMONITOR_PASSWORD=
# The server's own browser (the browser service), for signing in to sites from the Dashboard: its
# address as your reverse proxy serves it, relative to dreamfeed's (e.g. browser/ for
# /dreamfeed/browser/; README: Sign-ins). Empty: the Dashboard doesn't offer it.
BROWSER_URL=
# Optional (the Dashboard's Sign-ins does this, signing in for you): your own Reddit app at
# reddit.com/prefs/apps, for Reddit in the Feed.
# Extra subreddits are set on the Dashboard. REDDIT_USERNAME: yours, for the app's user agent.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
# Signed in as you (docker compose exec follow python -m dreamfeed follow reddit-login): the Feed
# reads the subreddits you're subscribed to, plus any added on the Dashboard. Empty: no Reddit.
REDDIT_REFRESH_TOKEN=
# Optional: your e621 username, named in dreamfeed's user agent there (as e621 asks of scripts),
# and an API key to sign in as you (favorites, votes, your blacklist, For you's taste; easier on
# the Dashboard's Sign-ins, which come first).
E621_USERNAME=
E621_API_KEY=
# The follow service: RAM cap and CPU threads (for cutting highlights of your videos).
FOLLOW_MEM_LIMIT=7g
FOLLOW_THREADS=4

# Feed web page: optional fixed login name (otherwise chosen with the password).
DREAMFEED_USERNAME=

# Where to build the formlogin sign-in library from: a git URL pinned to a tag
# (e.g. https://github.com/<owner>/formlogin.git#v2.0.0) or a local folder.
FORMLOGIN_SRC=

# Optional: the id of X's "more videos" call (ImmersiveMedia) when X changes it (empty: the one known to work).
X_RELATED_QUERY=

# Optional: Browse's 🎲 Random: an https address of a text file of subreddit names, one a line
# (read again each day; the usual subreddit rules still apply). Empty: no 🎲.
RANDOM_SUBREDDITS_URL=
