# Copy to .env and fill in.

# User and group the containers run as (owner of this folder): `id -u`, `id -g`.
PUID=
PGID=
TZ=

# CPU threads for age estimation (it runs on the CPU so the GPU stays free).
AGECHECK_THREADS=8

# X cookies exported from your browser (Netscape cookies.txt format), used to download an
# artist's images from x.com when you train a style. Keep it outside version control.
X_COOKIES_FILE=

# Chaturbate cookies (Netscape cookies.txt), so the Following page knows which rooms you
# follow. Replace the file in place (cp over it) when you export them again.
CHATURBATE_COOKIES_FILE=
# Your own Reddit app (a "personal use script" at reddit.com/prefs/apps), so the Feed gets
# galleries and Reddit's own videos too; empty: Reddit's public RSS feeds (pictures and redgifs).
# The subreddits are set on the Dashboard. REDDIT_USERNAME: yours, for the app's user agent.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
# Signed in as you (docker compose exec follow python -m dreamfeed follow reddit-login): the Feed
# reads the subreddits you're subscribed to, plus any added on the Dashboard.
REDDIT_REFRESH_TOKEN=
# Optional: your e621 username, named in dreamfeed's user agent there (as e621 asks of scripts).
E621_USERNAME=
# The follow service: RAM cap (its checks need about 5 GB while it reads the feeds) and CPU
# threads for the checks.
FOLLOW_MEM_LIMIT=7g
FOLLOW_THREADS=4

# Folder for style training: downloaded images, training copies, post texts (about 1 GB per
# style). Can be a slower disk; the trained LoRAs themselves stay in ./models/loras.
# Use ./data/lora to keep it here.
LORA_DATA_DIR=

# Generation: one SDXL model per medium, file names in ./models/checkpoints.
# Personas (data/personas.json) use the one matching their medium. Nightly images are split
# between personas by their weight and your likes and skips.
CHECKPOINT_ANIME=
CHECKPOINT_FURRY=
# Seconds without a job before ComfyUI is stopped to free the GPU.
COMFY_IDLE_STOP_SECONDS=600
# RAM ComfyUI may use (Docker size). Keep it under what the server has free with ComfyUI
# stopped (check with `free -g`), minus a few GB: past that, other services are pushed into
# swap and the whole server stalls.
COMFY_MEM_LIMIT=14g
# Safety net: ComfyUI is killed if the whole server has less than this much memory free (GB).
COMFY_HOST_MIN_FREE_GB=3
# RAM the worker may use (tagger, CLIP, caption model; it peaks around 6 GB).
WORKER_MEM_LIMIT=10g
GENERATE_WINDOW=01:00-07:00
IMAGES_PER_NIGHT=400
FEED_KEEP_TOP=60
# Feed images you haven't liked are deleted after this many days (liked ones are kept).
FEED_KEEP_DAYS=14
# Wan 2.2 clips made after each night's images, from likes and the night's best (0 = off).
# About 5 minutes each.
VIDEOS_PER_NIGHT=0
# Motion LoRA for clips of sex acts (Wan 2.2 I2V, one file per noise expert, in ./models/loras).
# Made for DR34ML4Y v2 (civitai.com/models/1811313): its trigger words are in worker/dreamfeed/motion.py.
# Empty: clips use Wan alone.
VIDEO_ACT_LORA_HIGH=
VIDEO_ACT_LORA_LOW=
VIDEO_ACT_LORA_STRENGTH=0.8
# Strength of a style's own video LoRA in its personas' clips.
VIDEO_STYLE_LORA_STRENGTH=0.7

# Text model (Hugging Face id) that writes a fresh caption for every post that reaches the feed,
# in the persona's voice. About 8 GB, downloaded to ./models/hf on first use; runs on the GPU for
# a minute or so after each night's checks. Empty: captions are picked from the personas' examples.
CAPTION_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Feed web page: optional fixed login name (otherwise chosen with the password).
DREAMFEED_USERNAME=

# Civitai API key, for downloading models that need a signed-in account (civitai.com > Account settings > API Keys).
CIVITAI_API_KEY=

# Where to build the formlogin sign-in library from: a git URL pinned to a tag
# (e.g. https://github.com/<owner>/formlogin.git#v2.0.0) or a local folder.
FORMLOGIN_SRC=

# Video LoRAs (optional; see README). Folder with the full-precision Wan 2.2 I2V weights.
VIDEO_TRAIN_MODELS=
# RAM cap for video training: about 16 GB while loading the model, 13 GB after.
VIDEO_TRAIN_MEM_LIMIT=17g
# Training clip size: square side in pixels and frames per sample (4N+1, 16 per second).
VIDEO_TRAIN_RES=320
VIDEO_TRAIN_FRAMES=33
# Wan blocks (of 40) kept in RAM instead of on the GPU; lower is faster but needs more VRAM.
VIDEO_TRAIN_BLOCKS_TO_SWAP=32
